# ==========================================
# FastSS Configuration Environment Variables
# ==========================================

# Folder path where screenshots will be saved.
# Supports relative path (e.g. picture/screnshoot) or absolute path (e.g. C:/Users/USER/Pictures/Screenshots)
FASTSS_OUTPUT_DIR=picture/screnshoot

# Default annotation color (red, green, blue, yellow, orange, magenta, cyan, or hex #FF0000)
FASTSS_DEFAULT_COLOR=red

# Default stroke width for boxes and arrows (in pixels)
FASTSS_STROKE_WIDTH=4.0

# Optional delay before screenshot in seconds (default: 0)
FASTSS_DELAY_SECONDS=0
